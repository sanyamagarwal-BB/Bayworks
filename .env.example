# ── BAYWORKS marketing site (Vite) ──────────────────────────────────────────
# Copy to `.env` for local dev, or set these in your host's build env (Vercel,
# Netlify, etc.). All client-exposed vars MUST be prefixed VITE_.

# Base URL the browser uses to reach the CRM API.
#  - DEV: leave as "/crm-api" — vite.config.js proxies it to VITE_CRM_TARGET.
#  - PROD: set to the API's public origin INCLUDING /api,
#          e.g. https://crm.bayworks.in/api   (then set CORS_ORIGIN on the API
#          to this site's domain — see DEPLOY.md).
VITE_CRM_BASE="/crm-api"

# Dev-only: where the /crm-api proxy forwards to (the running CRM API host).
VITE_CRM_TARGET="http://localhost:3001"

# Tenant capture token — resolves which tenant portal signups/logins belong to.
VITE_CRM_TOKEN="cap_ohlt1p4glsp"

# Where the "Team login" (staff) link in the nav points (the CRM web app).
VITE_CRM_WEB_URL="http://localhost:5180/login"

# WhatsApp number for the floating contact button (digits only, incl. country code).
VITE_WHATSAPP_NUMBER="919205005399"
