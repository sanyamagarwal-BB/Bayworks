<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BAYWORKS™ CMS Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Outfit', -apple-system, sans-serif;
      background: #0F172A;
      color: #E2E8F0;
      min-height: 100vh;
      display: flex;
      transition: background 0.3s, color 0.3s;
    }

    /* ─ LIGHT MODE ───────────────────────────────────────────────── */
    body.light-mode {
      background: #F8FAFC;
      color: #1E293B;
    }

    body.light-mode .admin-sidebar {
      background: #FFFFFF;
      border-right-color: rgba(0,0,0,0.08);
    }

    body.light-mode .admin-sidebar .admin-logo {
      border-bottom-color: rgba(0,0,0,0.08);
    }

    body.light-mode .admin-logo-text {
      color: #0F172A;
    }

    body.light-mode .admin-nav-btn {
      color: rgba(30,41,59,0.60);
    }

    body.light-mode .admin-nav-btn:hover {
      color: #0F172A;
      background: rgba(0,0,0,0.04);
    }

    body.light-mode .admin-nav-btn.active {
      color: #059669;
      background: rgba(5,150,105,0.10);
      border-left-color: #059669;
    }

    body.light-mode .admin-main {
      background: #F8FAFC;
    }

    body.light-mode .admin-title {
      color: #0F172A;
    }

    body.light-mode .admin-section-title {
      color: #0F172A;
      border-bottom-color: rgba(5,150,105,0.30);
    }

    body.light-mode .admin-field label {
      color: rgba(30,41,59,0.70);
    }

    body.light-mode .admin-field input,
    body.light-mode .admin-field textarea {
      background: #FFFFFF;
      border-color: rgba(0,0,0,0.12);
      color: #0F172A;
    }

    body.light-mode .admin-field input:focus,
    body.light-mode .admin-field textarea:focus {
      border-color: rgba(5,150,105,0.60);
      background: rgba(5,150,105,0.05);
    }

    body.light-mode .admin-btn-reset {
      background: rgba(0,0,0,0.04);
      color: #0F172A;
      border-color: rgba(0,0,0,0.12);
    }

    body.light-mode .admin-btn-reset:hover {
      background: rgba(0,0,0,0.08);
    }

    body.light-mode .admin-status.success {
      background: rgba(5,150,105,0.10);
      border-color: rgba(5,150,105,0.30);
      color: #047857;
    }

    body.light-mode .admin-status.error {
      background: rgba(220,38,38,0.10);
      border-color: rgba(220,38,38,0.30);
      color: #991B1B;
    }

    body.light-mode .client-input {
      background: #FFFFFF !important;
      border-color: rgba(0,0,0,0.12) !important;
      color: #0F172A !important;
    }

    /* ─ THEME TOGGLE ─────────────────────────────────────────────── */
    .theme-toggle {
      position: fixed;
      top: 20px;
      right: 20px;
      z-index: 9999;
      background: rgba(255,255,255,0.10);
      border: 1px solid rgba(255,255,255,0.20);
      border-radius: 50px;
      padding: 8px 12px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 1.2rem;
      transition: all 0.3s;
      color: #E2E8F0;
    }

    .theme-toggle:hover {
      background: rgba(255,255,255,0.15);
      border-color: rgba(255,255,255,0.30);
      transform: scale(1.05);
    }

    body.light-mode .theme-toggle {
      background: rgba(0,0,0,0.10);
      border-color: rgba(0,0,0,0.20);
      color: #0F172A;
    }

    body.light-mode .theme-toggle:hover {
      background: rgba(0,0,0,0.15);
      border-color: rgba(0,0,0,0.30);
    }

    /* ─ SIDEBAR ──────────────────────────────────────────────────── */
    .admin-sidebar {
      width: 260px;
      background: #111827;
      border-right: 1px solid rgba(255,255,255,0.08);
      display: flex;
      flex-direction: column;
      padding: 2rem 0;
      position: fixed;
      height: 100vh;
      overflow-y: auto;
    }

    .admin-logo {
      padding: 0 1.5rem 2rem;
      margin-bottom: 1rem;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .admin-logo-text {
      font-size: 1.4rem;
      font-weight: 700;
      color: #FFFFFF;
    }

    .admin-nav {
      list-style: none;
      flex: 1;
    }
    .admin-nav-item {
      display: block;
    }
    .admin-nav-btn {
      width: 100%; text-align: left;
      padding: 0.9rem 1.5rem;
      background: none; border: none;
      color: rgba(226,232,240,0.60);
      font-size: 0.9rem; font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
    }
    .admin-nav-btn:hover {
      color: #FFFFFF;
      background: rgba(255,255,255,0.04);
    }
    .admin-nav-btn.active {
      color: #4ADE80;
      background: rgba(74,222,128,0.10);
      border-left: 3px solid #4ADE80;
      padding-left: calc(1.5rem - 3px);
    }

    /* ─ MAIN CONTENT ────────────────────────────────────────────── */
    .admin-main {
      flex: 1;
      margin-left: 260px;
      padding: 2.5rem;
      overflow-y: auto;
    }

    .admin-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 2.5rem;
    }
    .admin-title {
      font-size: 1.8rem;
      font-weight: 700;
      color: #FFFFFF;
    }

    .admin-actions {
      display: flex;
      gap: 0.8rem;
    }
    .admin-btn {
      padding: 0.7rem 1.4rem;
      border-radius: 6px;
      border: none;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }
    .admin-btn-save {
      background: #4ADE80;
      color: #111827;
    }
    .admin-btn-save:hover {
      background: #22C55E;
      transform: translateY(-1px);
      box-shadow: 0 4px 16px rgba(74,222,128,0.30);
    }
    .admin-btn-reset {
      background: rgba(255,255,255,0.08);
      color: #FFFFFF;
      border: 1px solid rgba(255,255,255,0.14);
    }
    .admin-btn-reset:hover {
      background: rgba(255,255,255,0.14);
    }
    .admin-btn-view {
      background: rgba(74,222,128,0.10);
      color: #4ADE80;
      border: 1px solid rgba(74,222,128,0.30);
    }
    .admin-btn-view:hover {
      background: rgba(74,222,128,0.16);
    }

    /* ─ SECTIONS ────────────────────────────────────────────────── */
    .admin-section {
      display: none;
    }
    .admin-section.active { display: block; }

    .admin-section-title {
      font-size: 1.3rem;
      font-weight: 700;
      color: #FFFFFF;
      margin-bottom: 1.5rem;
      padding-bottom: 0.8rem;
      border-bottom: 1px solid rgba(74,222,128,0.30);
    }

    .admin-form {
      display: grid;
      gap: 1.8rem;
    }

    .admin-field {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .admin-field label {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(226,232,240,0.50);
    }
    .admin-field input,
    .admin-field textarea {
      padding: 0.8rem 1rem;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 6px;
      color: #FFFFFF;
      font-family: 'Outfit', sans-serif;
      font-size: 0.9rem;
      outline: none;
      transition: border-color 0.2s;
    }
    .admin-field input:focus,
    .admin-field textarea:focus {
      border-color: rgba(74,222,128,0.60);
      background: rgba(255,255,255,0.08);
    }
    .admin-field textarea {
      resize: vertical;
      min-height: 80px;
      line-height: 1.5;
    }

    .admin-field-hint {
      font-size: 0.75rem;
      color: rgba(226,232,240,0.35);
      margin-top: 0.2rem;
    }

    /* ─ GRID: Two columns on wider screens ──────────────────────── */
    @media (min-width: 1200px) {
      .admin-form {
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
      }
      .admin-field--full {
        grid-column: 1 / -1;
      }
    }

    /* ─ STATUS MESSAGE ──────────────────────────────────────────── */
    .admin-status {
      padding: 1rem;
      border-radius: 6px;
      margin-bottom: 1.5rem;
      font-size: 0.9rem;
      display: none;
    }
    .admin-status.show { display: block; }
    .admin-status.success {
      background: rgba(74,222,128,0.15);
      border: 1px solid rgba(74,222,128,0.30);
      color: #86EFAC;
    }
    .admin-status.error {
      background: rgba(239,68,68,0.15);
      border: 1px solid rgba(239,68,68,0.30);
      color: #FCA5A5;
    }

    /* ─ RESPONSIVE ──────────────────────────────────────────────── */
    @media (max-width: 900px) {
      .admin-sidebar {
        width: 220px;
      }
      .admin-main {
        margin-left: 220px;
        padding: 1.5rem;
      }
      .admin-title {
        font-size: 1.4rem;
      }
    }

    @media (max-width: 700px) {
      body { flex-direction: column; }
      .admin-sidebar {
        width: 100%;
        height: auto;
        position: static;
        border-right: none;
        border-bottom: 1px solid rgba(255,255,255,0.08);
        padding: 1.5rem 0;
      }
      .admin-main {
        margin-left: 0;
      }
    }

    /* Testimonial photo uploader */
    .photo-uploader {
      display: flex; align-items: center; gap: 14px; margin-top: 6px; flex-wrap: wrap;
    }
    .photo-preview {
      display: none;
      width: 54px; height: 62px;       /* oval preview, matches the site */
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid #059669;
      background: #f1f5f9;
    }
    .photo-remove {
      background: none; border: 1px solid #d1d5db; border-radius: 6px;
      padding: 6px 12px; cursor: pointer; font: inherit;
    }
    .photo-remove:hover { border-color: #059669; color: #059669; }
    .photo-hint { display: block; margin-top: 6px; opacity: 0.6; }

    /* Client logo manager */
    .client-edit-card {
      display: flex; gap: 14px; align-items: center;
      padding: 12px; border-radius: 10px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.10);
    }
    body.light-mode .client-edit-card {
      background: #f8fafc; border-color: #e5e7eb;
    }
    .client-logo-box {
      width: 96px; height: 56px; flex-shrink: 0;
      border-radius: 8px; background: #ffffff;
      border: 1px solid rgba(0,0,0,0.08);
      display: flex; align-items: center; justify-content: center;
      overflow: hidden;
    }
    .client-logo-preview { display: none; max-width: 86px; max-height: 46px; object-fit: contain; }
    .client-logo-empty { font-size: 0.7rem; color: #94a3b8; }
    .client-edit-fields { flex: 1; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
    .client-name-input {
      width: 100%; padding: 0.6rem 0.7rem; border-radius: 6px;
      background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.14);
      color: inherit; font-family: Outfit, sans-serif; outline: none;
    }
    body.light-mode .client-name-input { background: #fff; border-color: #d1d5db; }
    .client-edit-actions { display: flex; gap: 8px; flex-wrap: wrap; }
    .client-upload-btn {
      padding: 0.45rem 0.9rem; border-radius: 6px; cursor: pointer; font-weight: 600;
      background: rgba(74,222,128,0.15); color: #16a34a; border: 1px solid rgba(74,222,128,0.40);
    }
    .client-logo-clear, .remove-client {
      padding: 0.45rem 0.9rem; border-radius: 6px; cursor: pointer; font-weight: 600;
      background: none; border: 1px solid #d1d5db; color: inherit; font: inherit;
    }
    .remove-client { border-color: rgba(239,68,68,0.40); color: #ef4444; }
    .client-logo-clear:hover { border-color: #16a34a; color: #16a34a; }
  </style>
</head>
<body>

  <!-- THEME TOGGLE -->
  <button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark/light mode" title="Toggle dark/light mode">
    <span id="theme-icon">🌙</span>
  </button>

  <!-- SIDEBAR -->
  <aside class="admin-sidebar">
    <div class="admin-logo">
      <span class="admin-logo-text">BAYWORKS™<br/><span style="font-size:0.7rem;color:rgba(226,232,240,0.50);font-weight:400;">CMS Dashboard</span></span>
    </div>
    <nav class="admin-nav">
      <button class="admin-nav-btn active" data-section="hero">Hero Section</button>
      <button class="admin-nav-btn" data-section="metrics">Metrics Strip</button>
      <button class="admin-nav-btn" data-section="pain">Pain Points</button>
      <button class="admin-nav-btn" data-section="solutions">Solutions</button>
      <button class="admin-nav-btn" data-section="testimonials">Testimonials</button>
      <button class="admin-nav-btn" data-section="clients">Clients Ribbon</button>
      <button class="admin-nav-btn" data-section="properties">Available Properties</button>
      <button class="admin-nav-btn" data-section="faq">FAQ</button>
      <button class="admin-nav-btn" data-section="pricing">Pricing</button>
      <button class="admin-nav-btn" data-section="process">Process</button>
      <button class="admin-nav-btn" data-section="case-studies">Case Studies</button>
      <button class="admin-nav-btn" data-section="team">Team</button>
      <button class="admin-nav-btn" data-section="about">About</button>
      <button class="admin-nav-btn" data-section="contact">Contact &amp; CTA</button>
      <button class="admin-nav-btn" data-section="footer">Footer</button>
      <hr style="border:none;border-top:1px solid rgba(255,255,255,0.08);margin:1rem 0;">
      <button class="admin-nav-btn" data-section="sprint2-prop">Sprint 2: Property Tools</button>
      <button class="admin-nav-btn" data-section="sprint2-fin">Sprint 2: Financial Tools</button>
      <button class="admin-nav-btn" data-section="sprint2-roadmap">Sprint 2: Tier 3 Roadmap</button>
    </nav>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="admin-main">
    <div class="admin-header">
      <h1 class="admin-title">Content Management</h1>
      <div class="admin-actions">
        <a href="/" class="admin-btn admin-btn-view">View Live Site →</a>
        <button id="reset-btn" class="admin-btn admin-btn-reset">Reset to Defaults</button>
        <button id="save-btn" class="admin-btn admin-btn-save">Save Changes</button>
      </div>
    </div>

    <div id="status" class="admin-status"></div>

    <!-- HERO SECTION -->
    <section id="hero" class="admin-section active">
      <h2 class="admin-section-title">Hero Section</h2>
      <form class="admin-form">
        <div class="admin-field">
          <label>Badge Text</label>
          <input type="text" id="hero_badge" placeholder="Live across 12 Cities + Dubai" />
        </div>
        <div class="admin-field">
          <label>H1 - Line 1</label>
          <input type="text" id="hero_h1_1" placeholder="Corporate Leasing," />
        </div>
        <div class="admin-field">
          <label>H1 - Line 2 (Accent)</label>
          <input type="text" id="hero_h1_2" placeholder="Without the Headache." />
        </div>
        <div class="admin-field admin-field--full">
          <label>Subheadline</label>
          <textarea id="hero_sub" placeholder="Grade-A offices across India and Dubai..."></textarea>
        </div>
      </form>
    </section>

    <!-- METRICS SECTION -->
    <section id="metrics" class="admin-section">
      <h2 class="admin-section-title">Metrics Strip</h2>
      <form class="admin-form">
        <div class="admin-field">
          <label>Metric 1 - Value</label>
          <input type="text" id="metric_1_val" placeholder="120k+" />
        </div>
        <div class="admin-field">
          <label>Metric 1 - Label</label>
          <input type="text" id="metric_1_label" placeholder="Sq. Ft. closed in a single deal" />
        </div>
        <div class="admin-field">
          <label>Metric 2 - Value</label>
          <input type="text" id="metric_2_val" placeholder="40%" />
        </div>
        <div class="admin-field">
          <label>Metric 2 - Label</label>
          <input type="text" id="metric_2_label" placeholder="Avg. lease liability reduction" />
        </div>
        <div class="admin-field">
          <label>Metric 3 - Value</label>
          <input type="text" id="metric_3_val" placeholder="0%" />
        </div>
        <div class="admin-field">
          <label>Metric 3 - Label</label>
          <input type="text" id="metric_3_label" placeholder="CapEx on managed fit-outs" />
        </div>
        <div class="admin-field">
          <label>Metric 4 - Value</label>
          <input type="text" id="metric_4_val" placeholder="7 days" />
        </div>
        <div class="admin-field">
          <label>Metric 4 - Label</label>
          <input type="text" id="metric_4_label" placeholder="Fastest deal closure on record" />
        </div>
      </form>
    </section>

    <!-- PAIN POINTS SECTION -->
    <section id="pain" class="admin-section">
      <h2 class="admin-section-title">Pain Points Section</h2>
      <form class="admin-form">
        <div class="admin-field admin-field--full">
          <label>Section Heading</label>
          <input type="text" id="pain_heading" placeholder="3 Headaches Every Procurement Team Faces" />
        </div>
        <div class="admin-field">
          <label>Pain Point 1 - Title</label>
          <input type="text" id="pain_1_title" placeholder="The Vendor Runaround" />
        </div>
        <div class="admin-field admin-field--full">
          <label>Pain Point 1 - Description</label>
          <textarea id="pain_1_desc" placeholder="Five different local brokers..."></textarea>
        </div>
        <div class="admin-field">
          <label>Pain Point 2 - Title</label>
          <input type="text" id="pain_2_title" placeholder="The Cash Burn" />
        </div>
        <div class="admin-field admin-field--full">
          <label>Pain Point 2 - Description</label>
          <textarea id="pain_2_desc" placeholder="Massive upfront CapEx..."></textarea>
        </div>
        <div class="admin-field">
          <label>Pain Point 3 - Title</label>
          <input type="text" id="pain_3_title" placeholder="The Scaling Trap" />
        </div>
        <div class="admin-field admin-field--full">
          <label>Pain Point 3 - Description</label>
          <textarea id="pain_3_desc" placeholder="Signing a strict 3–5 year..."></textarea>
        </div>
      </form>
    </section>

    <!-- SOLUTIONS SECTION -->
    <section id="solutions" class="admin-section">
      <h2 class="admin-section-title">Solutions Section</h2>
      <form class="admin-form">
        <div class="admin-field">
          <label>Solution 1 - Title</label>
          <input type="text" id="sol_1_title" placeholder="Zero-CapEx Managed Spaces" />
        </div>
        <div class="admin-field">
          <label>Solution 1 - Tag</label>
          <input type="text" id="sol_1_tag" placeholder="Balance Sheet Optimisation" />
        </div>
        <div class="admin-field admin-field--full">
          <label>Solution 1 - Description</label>
          <textarea id="sol_1_desc" placeholder="We specialise in sourcing..."></textarea>
        </div>

        <div class="admin-field">
          <label>Solution 2 - Title</label>
          <input type="text" id="sol_2_title" placeholder="48-Hour Filtering Protocol" />
        </div>
        <div class="admin-field">
          <label>Solution 2 - Tag</label>
          <input type="text" id="sol_2_tag" placeholder="Speed to Decision" />
        </div>
        <div class="admin-field admin-field--full">
          <label>Solution 2 - Description</label>
          <textarea id="sol_2_desc" placeholder="Give us your headcount..."></textarea>
        </div>

        <div class="admin-field">
          <label>Solution 3 - Title</label>
          <input type="text" id="sol_3_title" placeholder="Agility Built Into Every Lease" />
        </div>
        <div class="admin-field">
          <label>Solution 3 - Tag</label>
          <input type="text" id="sol_3_tag" placeholder="Future-Proof Leasing" />
        </div>
        <div class="admin-field admin-field--full">
          <label>Solution 3 - Description</label>
          <textarea id="sol_3_desc" placeholder="We structure flexible..."></textarea>
        </div>

        <div class="admin-field">
          <label>Solution 4 - Title</label>
          <input type="text" id="sol_4_title" placeholder="In-House Legal & Due Diligence" />
        </div>
        <div class="admin-field">
          <label>Solution 4 - Tag</label>
          <input type="text" id="sol_4_tag" placeholder="Risk Elimination" />
        </div>
        <div class="admin-field admin-field--full">
          <label>Solution 4 - Description</label>
          <textarea id="sol_4_desc" placeholder="Our legal team clears..."></textarea>
        </div>
      </form>
    </section>

    <!-- TESTIMONIALS SECTION -->
    <section id="testimonials" class="admin-section">
      <h2 class="admin-section-title">Testimonials Section</h2>
      <form class="admin-form">
        <div class="admin-field admin-field--full">
          <label>Testimonial 1 - Quote</label>
          <textarea id="test_1_quote" placeholder="Quote text here..."></textarea>
        </div>
        <div class="admin-field">
          <label>Testimonial 1 - Name</label>
          <input type="text" id="test_1_name" placeholder="Madhav Kumar" />
        </div>
        <div class="admin-field">
          <label>Testimonial 1 - Role</label>
          <input type="text" id="test_1_role" placeholder="VP, Operations — Tech Startup" />
        </div>
        <div class="admin-field admin-field--full">
          <label>Testimonial 1 - Photo (real person)</label>
          <div class="photo-uploader">
            <img data-preview="test_1_photo" alt="" class="photo-preview" />
            <input type="file" accept="image/*" class="photo-input" data-target="test_1_photo" />
            <button type="button" class="photo-remove" data-target="test_1_photo">Remove</button>
          </div>
          <input type="hidden" id="test_1_photo" />
          <small class="photo-hint">Upload a headshot — it displays as an oval. Auto-resized. Click Save when done.</small>
        </div>

        <div class="admin-field admin-field--full">
          <label>Testimonial 2 - Quote</label>
          <textarea id="test_2_quote" placeholder="Quote text here..."></textarea>
        </div>
        <div class="admin-field">
          <label>Testimonial 2 - Name</label>
