        </div>
        <div class="admin-field admin-field--full">
          <label>ESG & Sustainability - Description</label>
          <textarea id="sustain_desc" placeholder="See green certifications, carbon footprint..."></textarea>
        </div>
      </form>
    </section>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- SPRINT 2: TIER 3 ROADMAP (Coming Soon Features) -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <section id="sprint2-roadmap" class="admin-section">
      <h2 class="admin-section-title">Sprint 2: Tier 3 Roadmap (Coming Soon)</h2>
      <form class="admin-form">
        <div class="admin-field">
          <label>Feature 1 - Title</label>
          <input type="text" id="tier3_f1_title" placeholder="AI Property Matching" />
        </div>
        <div class="admin-field">
          <label>Feature 1 - Description</label>
          <input type="text" id="tier3_f1_desc" placeholder="ML-powered recommendations based on your company DNA" />
        </div>

        <div class="admin-field">
          <label>Feature 2 - Title</label>
          <input type="text" id="tier3_f2_title" placeholder="Predictive Analytics" />
        </div>
        <div class="admin-field">
          <label>Feature 2 - Description</label>
          <input type="text" id="tier3_f2_desc" placeholder="Forecast market trends 6 months ahead" />
        </div>

        <div class="admin-field">
          <label>Feature 3 - Title</label>
          <input type="text" id="tier3_f3_title" placeholder="Advanced Reporting" />
        </div>
        <div class="admin-field">
          <label>Feature 3 - Description</label>
          <input type="text" id="tier3_f3_desc" placeholder="Custom dashboards and BI integration" />
        </div>

        <div class="admin-field">
          <label>Feature 4 - Title</label>
          <input type="text" id="tier3_f4_title" placeholder="API Integration" />
        </div>
        <div class="admin-field">
          <label>Feature 4 - Description</label>
          <input type="text" id="tier3_f4_desc" placeholder="Sync with your ERP, HCM, and finance systems" />
        </div>

        <div class="admin-field">
          <label>Feature 5 - Title</label>
          <input type="text" id="tier3_f5_title" placeholder="Global Expansion" />
        </div>
        <div class="admin-field">
          <label>Feature 5 - Description</label>
          <input type="text" id="tier3_f5_desc" placeholder="Coverage expanding to Singapore, HK, London" />
        </div>

        <div class="admin-field">
          <label>Feature 6 - Title</label>
          <input type="text" id="tier3_f6_title" placeholder="Tenant Communities" />
        </div>
        <div class="admin-field">
          <label>Feature 6 - Description</label>
          <input type="text" id="tier3_f6_desc" placeholder="Network with 500+ corporate tenants" />
        </div>

        <div class="admin-field">
          <label>Feature 7 - Title</label>
          <input type="text" id="tier3_f7_title" placeholder="White Label Solutions" />
        </div>
        <div class="admin-field">
          <label>Feature 7 - Description</label>
          <input type="text" id="tier3_f7_desc" placeholder="Reseller program for brokers & advisors" />
        </div>

        <div class="admin-field">
          <label>Feature 8 - Title</label>
          <input type="text" id="tier3_f8_title" placeholder="Enterprise Customization" />
        </div>
        <div class="admin-field">
          <label>Feature 8 - Description</label>
          <input type="text" id="tier3_f8_desc" placeholder="Custom workflows for your org" />
        </div>
      </form>
    </section>

  </main>

  <script type="module">
    import { loadCMS, saveCMS, DEFAULTS, MOCK_LOGOS } from './src/cms.js';

    const CMS_KEY = 'bayworks_cms';
    const navBtns = document.querySelectorAll('.admin-nav-btn');
    const sections = document.querySelectorAll('.admin-section');
    const saveBtn = document.getElementById('save-btn');
    const resetBtn = document.getElementById('reset-btn');
    const statusEl = document.getElementById('status');

    // Client management
    // Clients are objects { name, logo }. Legacy string entries are upgraded.
    let clientsData = [];

    function normalizeClients(raw) {
      let arr = [];
      try { arr = JSON.parse(raw || '[]'); } catch (e) { arr = []; }
      return arr.map(c => (typeof c === 'string'
        ? { name: c, logo: '' }
        : { name: c.name || '', logo: c.logo || '' }));
    }

    function saveClients() {
      const data = loadCMS();
      data.clients_list = JSON.stringify(clientsData);
      saveCMS(data);
      const w = window.opener; if (w) w.location.reload();
    }
    let clientsSaveTimer;
    function saveClientsDebounced() {
      clearTimeout(clientsSaveTimer);
      clientsSaveTimer = setTimeout(saveClients, 800);
    }

    // Resize/encode an uploaded logo (SVG kept as-is to stay crisp)
    function fileToLogoDataURL(file, max = 480) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onerror = reject;
        reader.onload = () => {
          if (file.type === 'image/svg+xml') { resolve(reader.result); return; }
          const img = new Image();
          img.onload = () => {
            const scale = Math.min(1, max / Math.max(img.width, img.height));
            const w = Math.round(img.width * scale);
            const h = Math.round(img.height * scale);
            const c = document.createElement('canvas');
            c.width = w; c.height = h;
            c.getContext('2d').drawImage(img, 0, 0, w, h);
            resolve(c.toDataURL('image/png')); // PNG preserves transparency
          };
          img.onerror = reject;
          img.src = reader.result;
        };
        reader.readAsDataURL(file);
      });
    }

    function refreshClientPreviews() {
      clientsData.forEach((c, idx) => {
        const img = document.querySelector(`[data-logo-preview="${idx}"]`);
        const empty = document.querySelector(`[data-logo-empty="${idx}"]`);
        if (!img) return;
        if (c.logo) { img.src = c.logo; img.style.display = 'block'; if (empty) empty.style.display = 'none'; }
        else { img.removeAttribute('src'); img.style.display = 'none'; if (empty) empty.style.display = 'flex'; }
      });
    }

    function renderClientsList() {
      clientsData = normalizeClients(loadCMS().clients_list);
      const container = document.getElementById('clients-list-container');
      container.innerHTML = clientsData.map((c, idx) => `
        <div class="client-edit-card">
          <div class="client-logo-box">
            <img class="client-logo-preview" data-logo-preview="${idx}" alt="" />
            <span class="client-logo-empty" data-logo-empty="${idx}">No logo</span>
          </div>
          <div class="client-edit-fields">
            <input type="text" class="client-name-input" data-idx="${idx}"
              value="${esc(c.name)}" placeholder="Brand name (shown if no logo / used as alt text)" />
            <div class="client-edit-actions">
              <label class="client-upload-btn">Upload logo
                <input type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" class="client-logo-input" data-idx="${idx}" hidden />
              </label>
              <button type="button" class="client-logo-clear" data-idx="${idx}">Clear logo</button>
              <button type="button" class="remove-client" data-idx="${idx}">Remove</button>
            </div>
          </div>
        </div>
      `).join('');
      refreshClientPreviews();
      wireClientEvents();
    }

    function wireClientEvents() {
      const container = document.getElementById('clients-list-container');
      container.querySelectorAll('.client-name-input').forEach(inp => {
        inp.addEventListener('input', () => {
          clientsData[+inp.dataset.idx].name = inp.value;
          saveClientsDebounced();
        });
      });
      container.querySelectorAll('.client-logo-input').forEach(inp => {
        inp.addEventListener('change', async () => {
          const file = inp.files && inp.files[0];
          if (!file) return;
          try {
            clientsData[+inp.dataset.idx].logo = await fileToLogoDataURL(file);
            saveClients();
            refreshClientPreviews();
            showStatus('Logo uploaded — saved.', 'success');
          } catch (e) {
            showStatus('Could not read that image. Try PNG, JPG or SVG.', 'error');
          }
          inp.value = '';
        });
      });
      container.querySelectorAll('.client-logo-clear').forEach(btn => {
        btn.addEventListener('click', () => {
          clientsData[+btn.dataset.idx].logo = '';
          saveClients();
          refreshClientPreviews();
          showStatus('Logo cleared.', 'success');
        });
      });
      container.querySelectorAll('.remove-client').forEach(btn => {
        btn.addEventListener('click', () => {
          clientsData.splice(+btn.dataset.idx, 1);
          saveClients();
          renderClientsList();
          showStatus('Client removed.', 'success');
        });
      });
    }

    // Property management
    const PROP_CITIES = ['Gurugram', 'Mumbai', 'Bengaluru', 'Hyderabad'];
    const PROP_BUCKETS = ['0-5k sqft', '5k-20k sqft', '20k-50k sqft', '50k+ sqft'];
    const PROP_STATUSES = ['Available', 'Hot Deal', 'Leased'];

    function getProperties() {
      try { return JSON.parse(loadCMS().properties_list || '[]'); }
      catch(e) { return []; }
    }

    const inputStyle = 'width:100%; padding:0.6rem; background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.12); border-radius:6px; color:#FFFFFF; font-family:Outfit,sans-serif; outline:none;';
    const esc = s => String(s ?? '').replace(/"/g, '&quot;');
    const opts = (list, sel) => list.map(o => `<option ${o === sel ? 'selected' : ''}>${o}</option>`).join('');

    function renderPropertiesList() {
      const props = getProperties();
      const container = document.getElementById('properties-list-container');
      container.innerHTML = props.map((p, idx) => `
        <div class="property-edit-card" data-prop-idx="${idx}" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.10); border-radius:10px; padding:1.2rem;">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.9rem;">
            <strong style="color:#FFFFFF; font-size:0.95rem;">Property ${idx + 1}</strong>
            <button type="button" class="remove-property" data-idx="${idx}" style="padding:0.4rem 0.9rem; background:rgba(239,68,68,0.15); color:#FCA5A5; border:1px solid rgba(239,68,68,0.30); border-radius:6px; cursor:pointer; font-weight:600; font-size:0.8rem;">Remove</button>
          </div>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.7rem;">
            <div style="grid-column:1 / -1;"><label style="display:block; font-size:0.75rem; color:rgba(255,255,255,0.55); margin-bottom:0.3rem;">Name</label><input type="text" class="prop-input" data-field="name" value="${esc(p.name)}" style="${inputStyle}" /></div>
            <div><label style="display:block; font-size:0.75rem; color:rgba(255,255,255,0.55); margin-bottom:0.3rem;">City</label><select class="prop-input" data-field="city" style="${inputStyle}">${opts(PROP_CITIES, p.city)}</select></div>
            <div><label style="display:block; font-size:0.75rem; color:rgba(255,255,255,0.55); margin-bottom:0.3rem;">Size (display)</label><input type="text" class="prop-input" data-field="size" value="${esc(p.size)}" placeholder="12,000 sq ft" style="${inputStyle}" /></div>
            <div><label style="display:block; font-size:0.75rem; color:rgba(255,255,255,0.55); margin-bottom:0.3rem;">Size Filter Bucket</label><select class="prop-input" data-field="bucket" style="${inputStyle}">${opts(PROP_BUCKETS, p.bucket)}</select></div>
            <div><label style="display:block; font-size:0.75rem; color:rgba(255,255,255,0.55); margin-bottom:0.3rem;">Price</label><input type="text" class="prop-input" data-field="price" value="${esc(p.price)}" placeholder="₹95/sq ft/mo" style="${inputStyle}" /></div>
            <div><label style="display:block; font-size:0.75rem; color:rgba(255,255,255,0.55); margin-bottom:0.3rem;">Type</label><input type="text" class="prop-input" data-field="type" value="${esc(p.type)}" placeholder="Managed Floor" style="${inputStyle}" /></div>
            <div><label style="display:block; font-size:0.75rem; color:rgba(255,255,255,0.55); margin-bottom:0.3rem;">Status</label><select class="prop-input" data-field="status" style="${inputStyle}">${opts(PROP_STATUSES, p.status)}</select></div>
          </div>
        </div>
      `).join('');

      // Remove buttons
      container.querySelectorAll('.remove-property').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const props = getProperties();
          props.splice(parseInt(btn.dataset.idx), 1);
          const data = loadCMS();
          data.properties_list = JSON.stringify(props);
          saveCMS(data);
          renderPropertiesList();
          showStatus('Property removed. Saved.', 'success');
        });
      });

      // Auto-save on edit
      container.querySelectorAll('.prop-input').forEach(el => {
        const handler = () => {
          clearTimeout(autoSaveTimer);
          autoSaveTimer = setTimeout(() => {
            saveForm();
            const mainWindow = window.opener;
            if (mainWindow) mainWindow.location.reload();
          }, 1000);
        };
        el.addEventListener('input', handler);
        el.addEventListener('change', handler);
      });
    }

    function collectProperties() {
      const cards = document.querySelectorAll('#properties-list-container .property-edit-card');
      return Array.from(cards).map(card => {
        const get = f => card.querySelector(`[data-field="${f}"]`)?.value || '';
        return { name: get('name'), city: get('city'), size: get('size'), bucket: get('bucket'), price: get('price'), type: get('type'), status: get('status') };
      });
    }

    // Load CMS data into form
    function loadForm() {
      const data = loadCMS();
      Object.entries(data).forEach(([key, val]) => {
        const input = document.getElementById(key);
        if (input && key !== 'clients_list' && key !== 'properties_list') input.value = val;
      });
      renderClientsList();
      renderPropertiesList();
      refreshPhotoPreviews();
    }

    /* ── Testimonial photo upload (resize → base64 → hidden field) ── */
    function fileToResizedDataURL(file, max = 240, quality = 0.82) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => {
          const img = new Image();
          img.onload = () => {
            const scale = Math.min(1, max / Math.max(img.width, img.height));
            const w = Math.round(img.width * scale);
            const h = Math.round(img.height * scale);
            const c = document.createElement('canvas');
            c.width = w; c.height = h;
            c.getContext('2d').drawImage(img, 0, 0, w, h);
            resolve(c.toDataURL('image/jpeg', quality));
          };
          img.onerror = reject;
          img.src = reader.result;
        };
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
    }

    function refreshPhotoPreviews() {
      document.querySelectorAll('[data-preview]').forEach(preview => {
        const hidden = document.getElementById(preview.dataset.preview);
        const val = hidden && hidden.value;
        if (val) { preview.src = val; preview.style.display = 'block'; }
        else { preview.removeAttribute('src'); preview.style.display = 'none'; }
      });
    }

    function setupPhotoUploaders() {
      document.querySelectorAll('.photo-input').forEach(input => {
        input.addEventListener('change', async () => {
          const file = input.files && input.files[0];
          if (!file) return;
          try {
            const dataURL = await fileToResizedDataURL(file);
            const hidden = document.getElementById(input.dataset.target);
            hidden.value = dataURL;
            const preview = document.querySelector(`[data-preview="${input.dataset.target}"]`);
            if (preview) { preview.src = dataURL; preview.style.display = 'block'; }
            hidden.dispatchEvent(new Event('change')); // triggers auto-save
            showStatus('Photo added — saving…', 'success');
          } catch (e) {
            showStatus('Could not read that image. Try a JPG or PNG.', 'error');
          }
          input.value = ''; // allow re-selecting the same file
        });
      });
      document.querySelectorAll('.photo-remove').forEach(btn => {
        btn.addEventListener('click', () => {
          const hidden = document.getElementById(btn.dataset.target);
          hidden.value = '';
          const preview = document.querySelector(`[data-preview="${btn.dataset.target}"]`);
          if (preview) { preview.removeAttribute('src'); preview.style.display = 'none'; }
          hidden.dispatchEvent(new Event('change')); // triggers auto-save
          showStatus('Photo removed — saving…', 'success');
        });
      });
    }

    // Save form data
    function saveForm() {
      const data = {};
      document.querySelectorAll('input, textarea').forEach(el => {
        if (el.id && el.id !== 'clients_list') data[el.id] = el.value;
      });
      // Clients (name + logo objects) are managed in clientsData
      data.clients_list = JSON.stringify(clientsData);
      // Handle properties list separately (or preserve existing if section not loaded)
      if (document.querySelector('#properties-list-container .property-edit-card')) {
        data.properties_list = JSON.stringify(collectProperties());
      } else {
        data.properties_list = loadCMS().properties_list;
      }
      saveCMS(data);
      showStatus('Saved successfully! Changes live in 5 seconds.', 'success');
    }

    // Reset to defaults
    function resetForm() {
      if (!confirm('Reset all content to defaults?')) return;
      localStorage.removeItem(CMS_KEY);
      loadForm();
      showStatus('Reset to defaults.', 'success');
    }

    // Show status message
    function showStatus(msg, type = 'success') {
      statusEl.textContent = msg;
      statusEl.className = `admin-status show ${type}`;
      setTimeout(() => statusEl.classList.remove('show'), 4000);
    }

    // Section navigation
    navBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        navBtns.forEach(b => b.classList.remove('active'));
        sections.forEach(s => s.classList.remove('active'));
        btn.classList.add('active');
        const sectionId = btn.dataset.section;
        document.getElementById(sectionId)?.classList.add('active');
      });
    });

    // Event listeners
    saveBtn.addEventListener('click', saveForm);
    resetBtn.addEventListener('click', resetForm);

    // Add client button
    document.getElementById('add-client-btn').addEventListener('click', (e) => {
      e.preventDefault();
      clientsData.push({ name: 'New Brand', logo: '' });
      saveClients();
      renderClientsList();
      showStatus('Client added — upload its logo below.', 'success');
    });

    // Load sample (mock) logos
    document.getElementById('load-mock-logos-btn').addEventListener('click', (e) => {
      e.preventDefault();
      const replace = clientsData.length === 0 ||
        confirm('Replace the current list with the sample logos?\n\nOK = replace · Cancel = add them to the existing list');
      const mocks = JSON.parse(JSON.stringify(MOCK_LOGOS));
      clientsData = replace ? mocks : clientsData.concat(mocks);
      saveClients();
      renderClientsList();
      showStatus('Sample logos loaded.', 'success');
    });

    // Add property button
    document.getElementById('add-property-btn').addEventListener('click', (e) => {
      e.preventDefault();
      const props = getProperties();
      props.push({ name: 'New Property', city: PROP_CITIES[0], size: '', bucket: PROP_BUCKETS[0], price: '', type: '', status: PROP_STATUSES[0] });
      const data = loadCMS();
      data.properties_list = JSON.stringify(props);
      saveCMS(data);
      renderPropertiesList();
      showStatus('Property added.', 'success');
    });

    // Auto-save on input (debounced)
    let autoSaveTimer;
    function setupAutoSave() {
      document.querySelectorAll('input, textarea').forEach(el => {
        el.addEventListener('change', () => {
          clearTimeout(autoSaveTimer);
          autoSaveTimer = setTimeout(() => {
            saveForm();
            // Reload main site preview if open
            const mainWindow = window.opener;
            if (mainWindow) mainWindow.location.reload();
          }, 1000);
        });
      });
    }
    setupAutoSave();
    setupPhotoUploaders();

    // Load on startup
    loadForm();

    /* ──────────────────────────────────────────────────────────────── */
    /* THEME TOGGLE (Dark/Light Mode) */
    /* ──────────────────────────────────────────────────────────────── */
    const themeToggle = document.getElementById('theme-toggle');
    const themeIcon = document.getElementById('theme-icon');
    const THEME_KEY = 'bayworks_admin_theme';

    // Load saved theme preference
    function loadTheme() {
      const savedTheme = localStorage.getItem(THEME_KEY) || 'dark';
      applyTheme(savedTheme);
    }

    // Apply theme
    function applyTheme(theme) {
      if (theme === 'light') {
        document.body.classList.add('light-mode');
        themeIcon.textContent = '☀️';
        localStorage.setItem(THEME_KEY, 'light');
      } else {
        document.body.classList.remove('light-mode');
        themeIcon.textContent = '🌙';
        localStorage.setItem(THEME_KEY, 'dark');
      }
    }

    // Toggle theme
    themeToggle.addEventListener('click', () => {
      const currentTheme = localStorage.getItem(THEME_KEY) || 'dark';
      const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
      applyTheme(newTheme);
    });

    // Load theme on page load
    loadTheme();
  </script>

</body>
</html>
